#. Plugin Name of the plugin
#: gadgetim-core.php
msgid "Gadgetim Core"
msgstr "هسته گجتیم"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: gadgetim-core.php
msgid "https://gadgetim.ir/"
msgstr "https://gadgetim.ir/"

#. Description of the plugin
#: gadgetim-core.php
msgid "Data and behaviour for the Gadgetim storefront: trilingual routing, multi-currency pricing, settings, catalog extras, importer and SEO. The \"Gadgetim — Timcheh\" theme is presentation only and relies on this plugin."
msgstr "داده‌ها و رفتار فروشگاه گجتیم: مسیریابی سه‌زبانه، قیمت‌گذاری چندارزی، تنظیمات، اطلاعات تکمیلی کاتالوگ، ابزار درون‌ریزی و سئو. پوسته «گجتیم — تیمچه» فقط ظاهر فروشگاه را می‌سازد و به این افزونه وابسته است."

