#. Theme Name of the theme
#. Author of the theme
#: style.css
msgid "Gadgetim"
msgstr "Gadgetim"

#. Theme URI of the theme
#: style.css
msgid "https://gadgetim.ir/"
msgstr "https://gadgetim.ir/"

#. Description of the theme
#: style.css
msgid "Aurora storefront theme for Gadgetim, an Iranian shop for original gadgets. Light, colourful and animated, RTL-first (Persian and Arabic) with an LTR English view, server-rendered WooCommerce templates and vanilla ES modules. Presentation only: data, pricing, languages and settings come from the gadgetim-core plugin."
msgstr "قالب «الشفق» لمتجر Gadgetim، المتجر الإيراني للأجهزة الأصلية. فاتح وملوّن وغني بالحركة، مصمَّم أولًا للكتابة من اليمين إلى اليسار (الفارسية والعربية) مع واجهة إنجليزية من اليسار إلى اليمين، وقوالب WooCommerce تُعرض من الخادم، ووحدات ES خالصة دون مكتبات. للعرض فقط: البيانات والتسعير واللغات والإعدادات تأتي من إضافة gadgetim-core."

